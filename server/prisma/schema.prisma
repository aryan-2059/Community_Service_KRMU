generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             // TEACHER | STUDENT
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  
  classroomsCreated Classroom[]   @relation("TeacherClassrooms")
  classEnrollments  ClassEnrollment[]
  quizzesCreated    Quiz[]
  assignments       Assignment[]
  quizAttempts      QuizAttempt[]
  studentAnswers    StudentQuestionAnswer[]

  @@map("users")
}

model Classroom {
  id          String             @id @default(uuid())
  name        String
  section     String
  joinCode    String             @unique
  teacherId   String
  teacher     User               @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  enrollments ClassEnrollment[]
  subjects    Subject[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassEnrollment {
  id          String    @id @default(uuid())
  classroomId String
  studentId   String
  enrolledAt  DateTime  @default(now())

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@map("class_enrollments")
}

model Subject {
  id          String    @id @default(uuid())
  classroomId String
  name        String
  code        String

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions   Question[]
  quizzes     Quiz[]

  @@map("subjects")
}

model Question {
  id            String    @id @default(uuid())
  subjectId     String
  topic         String
  questionText  String
  options       String    // Stored as JSON string
  correctOption String
  explanation   String
  difficulty    String    @default("MEDIUM") // EASY | MEDIUM | HARD

  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  studentAnswers StudentQuestionAnswer[]

  @@map("questions")
}

model Quiz {
  id               String    @id @default(uuid())
  subjectId        String
  title            String
  description      String?
  timeLimitMinutes Int       @default(30)
  totalMarks       Int       @default(10)
  createdById      String

  subject          Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  quizQuestions    QuizQuestion[]
  assignments      Assignment[]
  quizAttempts     QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  quizId     String
  questionId String
  marks      Int      @default(1)

  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
  @@map("quiz_questions")
}

model Assignment {
  id                  String    @id @default(uuid())
  quizId              String
  classroomId         String
  assignedToStudentId String?
  dueDate             DateTime
  createdAt           DateTime  @default(now())

  quiz                Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classroom           Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignedToStudent   User?     @relation(fields: [assignedToStudentId], references: [id], onDelete: Cascade)
  
  quizAttempts        QuizAttempt[]

  @@map("assignments")
}

model QuizAttempt {
  id               String    @id @default(uuid())
  quizId           String
  assignmentId     String?
  studentId        String
  score            Float
  totalScore       Float
  timeSpentSeconds Int?
  submittedAt      DateTime  @default(now())

  quiz             Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment       Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  student          User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentAnswers   StudentQuestionAnswer[]

  @@map("quiz_attempts")
}

model StudentQuestionAnswer {
  id             String      @id @default(uuid())
  attemptId      String
  studentId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("student_question_answers")
}
